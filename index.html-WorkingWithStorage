        async function callGraphAPI(endpoint, method = 'GET', body = null) {
            const token = await getAccessToken();
            const options = { method, headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' } };
            if (body) options.body = JSON.stringify(body);
            const resp = await fetch(`https://graph.microsoft.com/v1.0${endpoint}`, options);
            if (!resp.ok) throw new Error(`Graph API error: ${resp.status}`);
            if (resp.status === 204) return null;
            return resp.json();
        }

        async function loadCalendarEvents() {
            const content = document.getElementById('calendarContent');
            try {
                const now = new Date();
                const endDate = new Date();
                endDate.setDate(endDate.getDate() + 30);

                const events = await callGraphAPI(`/me/calendarView?startDateTime=${now.toISOString()}&endDateTime=${endDate.toISOString()}&$orderby=start/dateTime&$top=50`);

                if (!events.value || !events.value.length) {
                    content.innerHTML = '<div class="empty-state"><div class="empty-state-icon">📅</div><div>No upcoming events</div></div>';
                    return;
                }

                const grouped = {};
                events.value.forEach(event => {
                    const date = new Date(event.start.dateTime + 'Z').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });
                    if (!grouped[date]) grouped[date] = [];
                    grouped[date].push(event);
                });

                let html = '';
                Object.entries(grouped).forEach(([date, dayEvents]) => {
                    html += `<div class="event-day-header">${date}</div>`;
                    dayEvents.forEach(event => {
                        const start = new Date(event.start.dateTime + 'Z').toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
                        const end = new Date(event.end.dateTime + 'Z').toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
                        html += `<div class="event-item"><div class="event-time"><div class="event-time-start">${start}</div><div class="event-time-end">${end}</div></div><div class="event-divider"></div><div class="event-details"><div class="event-title">${escapeHtml(event.subject)}</div>${event.location && event.location.displayName ? `<div class="event-location">📍 ${escapeHtml(event.location.displayName)}</div>` : ''}</div></div>`;
                    });
                });
                content.innerHTML = html;
            } catch (e) {
                console.error('Calendar error:', e);
                content.innerHTML = '<div class="empty-state"><div class="empty-state-icon">⚠️</div><div>Could not load calendar</div></div>';
            }
        }

