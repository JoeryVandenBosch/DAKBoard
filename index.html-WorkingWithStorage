        // =====================================================
        async function signIn() {
            if (!apiConfig.functionUrl) {
                showToast('Please configure API settings first!', true);
                openModal('settings');
                setTimeout(() => switchSettingsTab('api'), 100);
                return;
            }

            try {
                const resp = await fetch(`${apiConfig.functionUrl}/api/auth/devicecode?code=${apiConfig.functionKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ client_id: clientId, scope: graphScopes })
                });

                if (!resp.ok) throw new Error('Failed to get device code');
                const data = await resp.json();
                if (data.error) throw new Error(data.error_description || 'Failed to get device code');

                document.getElementById('loginScreen').style.display = 'none';
                document.getElementById('deviceCodeScreen').style.display = 'flex';
                document.getElementById('userCode').textContent = data.user_code;
                document.getElementById('verificationUrl').href = data.verification_uri;

                const pollInterval = (data.interval || 5) * 1000;
                const expiresAt = Date.now() + (data.expires_in * 1000);

                deviceCodePolling = setInterval(async () => {
                    if (Date.now() > expiresAt) {
                        clearInterval(deviceCodePolling);
                        showToast('Code expired. Please try again.', true);
                        showLoginScreen();
                        return;
                    }

                    try {
                        const tokenResp = await fetch(`${apiConfig.functionUrl}/api/auth/token?code=${apiConfig.functionKey}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ client_id: clientId, device_code: data.device_code })
                        });

                        const tokenData = await tokenResp.json();

                        if (tokenData.access_token) {
                            clearInterval(deviceCodePolling);
                            authTokens = tokenData;
                            saveData(STORAGE_KEYS.AUTH_TOKENS, tokenData);
                            await fetchUserInfo();
                            document.getElementById('deviceCodeScreen').style.display = 'none';
                            showDashboard();
                            showToast('Successfully signed in!');
                        } else if (tokenData.error && tokenData.error !== 'authorization_pending') {
                            clearInterval(deviceCodePolling);
                            showToast(tokenData.error_description || 'Login failed', true);
                            showLoginScreen();
                        }
                    } catch (e) { console.error('Polling error:', e); }
                }, pollInterval);

            } catch (error) {
                console.error('Login error:', error);
                showToast('Login failed: ' + error.message, true);
                showLoginScreen();
            }
        }

        function cancelLogin() {
            if (deviceCodePolling) clearInterval(deviceCodePolling);
