        async function checkApiConnection() {
            const dot = document.getElementById('apiStatusDot');
            const text = document.getElementById('apiStatusText');

            if (!apiConfig.functionUrl) {
                dot.className = 'api-status-dot';
                text.textContent = 'Not configured';
                return;
            }

            try {
                const resp = await fetch(`${apiConfig.functionUrl}/api/status`);
                if (resp.ok) {
                    const data = await resp.json();
                    dot.className = 'api-status-dot connected';
                    text.textContent = `Connected - ${data.config && data.config.enabledContacts ? data.config.enabledContacts : 0} contacts`;
                } else throw new Error();
            } catch (e) {
                dot.className = 'api-status-dot error';
                text.textContent = 'Connection failed';
            }
        }

        async function saveApiSettings() {
            apiConfig.functionUrl = document.getElementById('functionUrl').value.trim().replace(/\/$/, '');
            apiConfig.functionKey = document.getElementById('functionKey').value.trim();
            saveData(STORAGE_KEYS.API_CONFIG, apiConfig);
            showToast('Testing connection...');
            await checkApiConnection();
            await syncContactsToApi();
            await syncSettingsToApi();
        }

