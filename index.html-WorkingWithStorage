        // =====================================================
        // @MENTION FUNCTIONALITY
        // =====================================================
        let mentionSelectedIndex = 0;
        let mentionFilteredContacts = [];

        function initMentionSystem() {
            const input = document.getElementById('todoTitle');
            const dropdown = document.getElementById('mentionDropdown');
            
            if (!input || !dropdown) return;

            input.addEventListener('input', handleMentionInput);
            input.addEventListener('keydown', handleMentionKeydown);
            input.addEventListener('blur', () => {
                // Delay hiding to allow click on dropdown
                setTimeout(() => dropdown.classList.remove('active'), 200);
            });
        }

        function handleMentionInput(e) {
            const input = e.target;
            const value = input.value;
            const cursorPos = input.selectionStart;
            const dropdown = document.getElementById('mentionDropdown');

            // Find if we're in a mention context (after @ but before space)
            const textBeforeCursor = value.substring(0, cursorPos);
            const mentionMatch = textBeforeCursor.match(/@(\w*)$/);

            if (mentionMatch && contacts.length > 0) {
                const searchTerm = mentionMatch[1].toLowerCase();
                mentionFilteredContacts = contacts.filter(c => 
                    c.name.toLowerCase().includes(searchTerm)
                );

                if (mentionFilteredContacts.length > 0) {
                    mentionSelectedIndex = 0;
                    renderMentionDropdown();
                    dropdown.classList.add('active');
                } else {
                    dropdown.classList.remove('active');
                }
            } else {
                dropdown.classList.remove('active');
            }
        }

        function handleMentionKeydown(e) {
            const dropdown = document.getElementById('mentionDropdown');
            if (!dropdown.classList.contains('active')) return;

            switch(e.key) {
                case 'ArrowDown':
                    e.preventDefault();
                    mentionSelectedIndex = Math.min(mentionSelectedIndex + 1, mentionFilteredContacts.length - 1);
                    renderMentionDropdown();
                    break;
                case 'ArrowUp':
                    e.preventDefault();
                    mentionSelectedIndex = Math.max(mentionSelectedIndex - 1, 0);
                    renderMentionDropdown();
                    break;
                case 'Enter':
                    if (mentionFilteredContacts.length > 0) {
                        e.preventDefault();
                        selectMention(mentionFilteredContacts[mentionSelectedIndex]);
                    }
                    break;
                case 'Escape':
                    dropdown.classList.remove('active');
                    break;
            }
        }

        function renderMentionDropdown() {
            const dropdown = document.getElementById('mentionDropdown');
            dropdown.innerHTML = mentionFilteredContacts.map((contact, index) => `
                <div class="mention-item ${index === mentionSelectedIndex ? 'selected' : ''}" 
                     onclick="selectMention(contacts.find(c => c.chatId === '${contact.chatId}'))">
                    <div class="mention-avatar">${contact.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase()}</div>
                    <div class="mention-name">${escapeHtml(contact.name)}</div>
                    <div class="mention-hint">Enter to select</div>
                </div>
            `).join('');
        }

        function selectMention(contact) {
            const input = document.getElementById('todoTitle');
            const dropdown = document.getElementById('mentionDropdown');
            const value = input.value;
            const cursorPos = input.selectionStart;

            // Find the @ position before cursor
            const textBeforeCursor = value.substring(0, cursorPos);
            const mentionMatch = textBeforeCursor.match(/@(\w*)$/);

            if (mentionMatch) {
                const atPosition = cursorPos - mentionMatch[0].length;
                const beforeAt = value.substring(0, atPosition);
                const afterCursor = value.substring(cursorPos);
                
                // Insert the mention with a space after
                const newValue = beforeAt + '@' + contact.name + ' ' + afterCursor;
                input.value = newValue;
                
                // Move cursor after the mention
                const newCursorPos = atPosition + contact.name.length + 2;
                input.setSelectionRange(newCursorPos, newCursorPos);
            }

            dropdown.classList.remove('active');
            input.focus();
        }

        function extractMentions(text) {
            const mentions = text.match(/@[\w\s]+/g) || [];
            const mentionedContacts = [];
            
            mentions.forEach(mention => {
                const name = mention.substring(1).trim();
                const contact = contacts.find(c => 
                    c.name.toLowerCase() === name.toLowerCase() ||
                    c.name.toLowerCase().startsWith(name.toLowerCase())
                );
                if (contact && !mentionedContacts.find(mc => mc.chatId === contact.chatId)) {
                    mentionedContacts.push(contact);
                }
            });
            
            return mentionedContacts;
        }

        async function sendMentionNotifications(taskTitle, mentionedContacts) {
            if (!apiConfig.functionUrl || mentionedContacts.length === 0) return;
            
            // Clean task title for notification (remove @mentions for cleaner message)
            const cleanTitle = taskTitle.replace(/@[\w\s]+/g, '').trim();
            const message = `📋 New task assigned to you:\n\n${cleanTitle || taskTitle}\n\nFrom: ${currentUser && currentUser.displayName ? currentUser.displayName : 'Family Dashboard'}`;
            
            try {
                // Use the testNotification endpoint with a custom message
                await fetch(`${apiConfig.functionUrl}/api/testNotification?code=${apiConfig.functionKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contacts: mentionedContacts.map(c => c.chatId),
                        message: message
                    })
                });
                showToast(`Notified ${mentionedContacts.map(c => c.name).join(', ')}!`);
            } catch (err) {
                console.error('Failed to send mention notification:', err);
            }
        }

