            try {
                const resp = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(name)}&count=1`);
                const data = await resp.json();

                if (!data.results || !data.results.length) { showToast('City not found', true); return; }

                const city = data.results[0];
                weatherLocations.forEach(l => l.active = false);
                weatherLocations.push({ name: city.name, lat: city.latitude, lon: city.longitude, active: true });
                saveData(STORAGE_KEYS.WEATHER_LOCATIONS, weatherLocations);

                document.getElementById('newLocationName').value = '';
                renderWeatherLocations();
                loadWeather();
                showToast(`Added ${city.name}`);
            } catch (e) { showToast('Error searching location', true); }
