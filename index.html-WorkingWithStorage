                let allTasks = [];
                for (const list of todoLists) {
                    const tasks = await callGraphAPI(`/me/todo/lists/${list.id}/tasks?$filter=status ne 'completed'&$top=10`);
                    if (tasks.value) {
                        tasks.value.forEach(t => t.listId = list.id);
