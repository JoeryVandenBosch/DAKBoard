                    }
                }

                if (!allTasks.length) {
                    content.innerHTML = '<div class="empty-state"><div class="empty-state-icon">✅</div><div>All done!</div></div>';
                    return;
                }

                allTasks.sort((a, b) => {
                    const order = { high: 0, normal: 1, low: 2 };
                    return (order[a.importance] || 1) - (order[b.importance] || 1);
                });

                content.innerHTML = allTasks.slice(0, 8).map(task => {
