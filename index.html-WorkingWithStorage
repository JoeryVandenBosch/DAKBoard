        function completeChoreAs(memberName) {
            try {
                var chore = null;
                for (var i = 0; i < chores.length; i++) {
                    if (chores[i].id === currentChoreId) {
                        chore = chores[i];
                        break;
                    }
                }
                var member = null;
                for (var j = 0; j < familyMembers.length; j++) {
                    if (familyMembers[j].name === memberName) {
                        member = familyMembers[j];
                        break;
                    }
                }
                if (!chore || !member) return;
                closeWhoModal();
                chore.completedBy.push(member.name);
                
                var oldRewardsCount = Math.floor(member.weeklyPoints / member.rewardPoints);
                var oldYearlyTotal = getYearlyTotal(member);
                
                member.weeklyPoints += chore.points;
                ensureYearData(member, CURRENT_YEAR);
                member.yearlyData[CURRENT_YEAR][CURRENT_MONTH] += chore.points;
                
                var newRewardsCount = Math.floor(member.weeklyPoints / member.rewardPoints);
                var earnedNewReward = newRewardsCount > oldRewardsCount;
                
                var newYearlyTotal = getYearlyTotal(member);
                var justWonJackpot = oldYearlyTotal < member.jackpotPoints && newYearlyTotal >= member.jackpotPoints && !member.jackpotWon[CURRENT_YEAR];
                
                if (earnedNewReward) {
                    playRewardSound();
                    showRewardCelebration(chore.points, member);
                } else {
                    playSuccessSound();
                    showChoreCelebration(chore.points, member.name);
                }
                
                saveV12Data();
                renderAllV12();
                
                if (justWonJackpot) {
                    member.jackpotWon[CURRENT_YEAR] = true;
                    saveV12Data();
                    setTimeout(function() { showJackpotCelebration(member); }, 2500);
                }
            } catch(e) {
                console.error('completeChoreAs error:', e);
            }
        }

        function showChoreCelebration(points, name) {
            try {
                var emojis = ['🎉', '⭐', '🌟', '💪', '🔥'];
                var texts = ['Great Job!', 'Awesome!', 'Well Done!', 'Amazing!'];
                var overlay = document.getElementById('choreCelebrationOverlay');
                document.getElementById('choreCelebrationEmoji').textContent = emojis[Math.floor(Math.random() * 5)];
                document.getElementById('choreCelebrationText').textContent = texts[Math.floor(Math.random() * 4)];
                document.getElementById('choreCelebrationPoints').textContent = '+' + points + ' point' + (points > 1 ? 's' : '') + ' for ' + name + '!';
                document.getElementById('choreCelebrationReward').textContent = '';
                overlay.classList.add('active');
                createChoreConfetti(50);
                setTimeout(function() { overlay.classList.remove('active'); }, 2200);
            } catch(e) {
                console.error('showChoreCelebration error:', e);
            }
        }

        function showRewardCelebration(points, member) {
            try {
                var overlay = document.getElementById('choreCelebrationOverlay');
                document.getElementById('choreCelebrationEmoji').textContent = '🎁';
                document.getElementById('choreCelebrationText').textContent = 'REWARD EARNED!';
                document.getElementById('choreCelebrationPoints').textContent = '+' + points + ' point' + (points > 1 ? 's' : '') + ' for ' + member.name + '!';
                document.getElementById('choreCelebrationReward').textContent = '🎁 ' + member.rewardGoal;
                overlay.classList.add('active');
                createChoreConfetti(80);
                setTimeout(function() { overlay.classList.remove('active'); }, 3000);
            } catch(e) {
                console.error('showRewardCelebration error:', e);
            }
        }

        function createChoreConfetti(count) {
            try {
                var overlay = document.getElementById('choreCelebrationOverlay');
                for (var i = 0; i < count; i++) {
                    var c = document.createElement('div');
                    c.className = 'chore-confetti';
                    var left = Math.random() * 100;
                    var bg = confettiColors[Math.floor(Math.random() * 6)];
                    var width = Math.random() * 10 + 5;
                    var height = Math.random() * 10 + 5;
                    var radius = Math.random() > 0.5 ? '50%' : '2px';
                    var delay = Math.random() * 0.5;
                    var duration = Math.random() * 2 + 2;
                    c.style.cssText = 'left:' + left + 'vw;top:-20px;background:' + bg + ';width:' + width + 'px;height:' + height + 'px;border-radius:' + radius + ';animation-delay:' + delay + 's;animation-duration:' + duration + 's';
                    overlay.appendChild(c);
                    (function(confetti) {
                        setTimeout(function() { confetti.classList.add('active'); }, 10);
                        setTimeout(function() { confetti.remove(); }, 4000);
                    })(c);
                }
            } catch(e) {
                console.error('createChoreConfetti error:', e);
            }
        }

        function showJackpotCelebration(member) {
            try {
                document.getElementById('jackpotWinnerName').textContent = member.emoji + ' ' + member.name;
                document.getElementById('jackpotPrizeText').textContent = '🎁 ' + member.jackpotGoal;
                document.getElementById('jackpotOverlay').classList.add('active');
                playJackpotSound();
            } catch(e) {
                console.error('showJackpotCelebration error:', e);
            }
        }

        function closeJackpotCelebration() { document.getElementById('jackpotOverlay').classList.remove('active'); }

        function openAddChoreModal() {
            document.getElementById('addChoreModal').classList.add('active');
            document.getElementById('choreNameInput').value = '';
        }

        function closeAddChoreModal() { document.getElementById('addChoreModal').classList.remove('active'); }

        function addChore() {
            var name = document.getElementById('choreNameInput').value.trim();
            if (!name) { showToast('⚠️ Enter a name', true); return; }
            chores.push({ id: Date.now(), name: name, points: parseInt(document.getElementById('chorePointsSelect').value), completedBy: [] });
            saveV12Data();
            renderChoresV12();
            closeAddChoreModal();
            showToast('✓ Added: ' + name);
        }

        function openEditRewardModal(memberName) {
            currentEditMember = familyMembers.find(m => m.name === memberName);
            if (!currentEditMember) return;
            document.getElementById('editRewardName').innerHTML = `${currentEditMember.emoji} ${currentEditMember.name}'s Weekly Goal`;
            document.getElementById('rewardGoalInput').value = currentEditMember.rewardGoal;
            document.getElementById('rewardPointsSelect').value = currentEditMember.rewardPoints.toString();
            document.getElementById('editRewardModal').classList.add('active');
        }

        function closeEditRewardModal() { document.getElementById('editRewardModal').classList.remove('active'); }

        function saveReward() {
            if (!currentEditMember) return;
            const goal = document.getElementById('rewardGoalInput').value.trim();
            if (!goal) { showToast('⚠️ Enter a reward', true); return; }
            currentEditMember.rewardGoal = goal;
            currentEditMember.rewardPoints = parseInt(document.getElementById('rewardPointsSelect').value);
            saveV12Data();
            renderAllV12();
            closeEditRewardModal();
            showToast('🎯 Goal updated!');
        }

        function requestJackpotEdit(memberName) {
            currentEditMember = familyMembers.find(m => m.name === memberName);
            pendingAction = 'editJackpot';
            requestPinForAction('editJackpot');
        }

        function openEditJackpotModalAfterPin() {
            if (!currentEditMember) return;
            document.getElementById('editJackpotName').innerHTML = `${currentEditMember.emoji} ${currentEditMember.name}'s Jackpot`;
            document.getElementById('jackpotGoalInput').value = currentEditMember.jackpotGoal;
            document.getElementById('jackpotPointsSelect').value = currentEditMember.jackpotPoints.toString();
            document.getElementById('editJackpotModal').classList.add('active');
        }

        function closeEditJackpotModal() { document.getElementById('editJackpotModal').classList.remove('active'); }

        function saveJackpot() {
            if (!currentEditMember) return;
            const goal = document.getElementById('jackpotGoalInput').value.trim();
            if (!goal) { showToast('⚠️ Enter a prize', true); return; }
            currentEditMember.jackpotGoal = goal;
            currentEditMember.jackpotPoints = parseInt(document.getElementById('jackpotPointsSelect').value);
            saveV12Data();
            renderAllV12();
            closeEditJackpotModal();
            showToast('🎰 Jackpot updated!');
        }

        function renderAllV12() { 
            try {
                renderScoreboard(); 
            } catch(e) { console.error('renderScoreboard error:', e); }
            try {
                renderJackpotCards(); 
            } catch(e) { console.error('renderJackpotCards error:', e); }
            try {
                renderMonthlyTable(); 
            } catch(e) { console.error('renderMonthlyTable error:', e); }
            try {
                renderChoresV12();
            } catch(e) { console.error('renderChoresV12 error:', e); }
        }

        // =====================================================
        // POPUP KEYBOARD SYSTEM
        // =====================================================
        let keyboardTarget = null;
        let keyboardCallback = null;
        let keyboardShift = false;

        function openKeyboard(targetInput, callback) {
            keyboardTarget = targetInput;
            keyboardCallback = callback;
            document.getElementById('keyboardInput').value = targetInput.value || '';
            document.getElementById('keyboardOverlay').classList.add('active');
            keyboardShift = false;
            updateShiftDisplay();
        }

        function keyboardDone() {
            const value = document.getElementById('keyboardInput').value;
            if (keyboardTarget) {
                keyboardTarget.value = value;
                // Trigger input event
                keyboardTarget.dispatchEvent(new Event('input', { bubbles: true }));
            }
            if (keyboardCallback) {
                keyboardCallback(value);
            }
            closeKeyboard();
        }

        function keyboardCancel() {
            closeKeyboard();
        }

        function closeKeyboard() {
            document.getElementById('keyboardOverlay').classList.remove('active');
            keyboardTarget = null;
            keyboardCallback = null;
            keyboardShift = false;
        }

        function updateShiftDisplay() {
            const shiftKey = document.getElementById('shiftKey');
            if (keyboardShift) {
                shiftKey.classList.add('active');
            } else {
                shiftKey.classList.remove('active');
            }
            // Update all letter keys
            document.querySelectorAll('.key[data-key]').forEach(key => {
                const keyVal = key.getAttribute('data-key');
                if (keyVal && keyVal.length === 1 && keyVal.match(/[a-z]/i)) {
                    key.textContent = keyboardShift ? keyVal.toUpperCase() : keyVal.toLowerCase();
                }
            });
        }

        // Keyboard key handler
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.key').forEach(key => {
                key.addEventListener('click', () => {
                    const keyVal = key.getAttribute('data-key');
                    const input = document.getElementById('keyboardInput');
                    
                    if (keyVal === 'backspace') {
                        input.value = input.value.slice(0, -1);
                    } else if (keyVal === 'shift') {
                        keyboardShift = !keyboardShift;
                        updateShiftDisplay();
                    } else if (keyVal === ' ') {
                        input.value += ' ';
                    } else {
                        const char = keyboardShift ? keyVal.toUpperCase() : keyVal;
                        input.value += char;
                        if (keyboardShift && keyVal.match(/[a-z]/i)) {
                            keyboardShift = false;
                            updateShiftDisplay();
                        }
                    }
                });
            });

            // Auto-open keyboard on input focus (for touch devices)
            document.addEventListener('focusin', (e) => {
                if (e.target.matches('input[type="text"], input[type="tel"], input:not([type])')) {
                    // Check if it's a dashboard input (not login screen)
                    if (document.getElementById('dashboard').style.display !== 'none') {
                        // Don't open keyboard for PIN inputs
                        if (!e.target.classList.contains('pin-digit')) {
                            e.target.blur(); // Prevent native keyboard
                            openKeyboard(e.target);
                        }
                    }
                }
            });
        });

        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('active'); });
        });
    </script>
