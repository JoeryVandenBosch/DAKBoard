        function verifyPinKeypad() {
            if (pinKeypadValue === PARENT_PIN) {
                const action = pendingAction;
                const choreIdToDelete = pendingDeleteChoreId;
                closePinKeypad();
                showToast('🔓 Access granted!');
                setTimeout(() => {
                    if (action === 'enableEditMode') {
                        enableEditMode();
                    } else if (action === 'deleteChore' && choreIdToDelete) {
                        confirmDeleteChore(choreIdToDelete);
                    } else {
                        executeAction(action);
                    }
                }, 200);
            } else {
                document.getElementById('pinKeypadError').textContent = '❌ Incorrect PIN';
                pinKeypadValue = '';
                updatePinKeypadDots();
                // Shake animation
                const keypad = document.querySelector('.pin-keypad');
