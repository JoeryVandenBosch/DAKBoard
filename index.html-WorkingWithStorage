                    headers: { 'Authorization': `Bearer ${authTokens.access_token}` }
                });
                currentUser = await resp.json();
                saveData(STORAGE_KEYS.USER_INFO, currentUser);
            } catch (e) { console.error('Failed to fetch user:', e); }
        }

        function signOut() {
            localStorage.removeItem(STORAGE_KEYS.AUTH_TOKENS);
            localStorage.removeItem(STORAGE_KEYS.USER_INFO);
            authTokens = null;
            currentUser = null;
            showLoginScreen();
            showToast('Signed out');
        }

        async function getAccessToken() {
            if (!authTokens) throw new Error('Not authenticated');
            try {
                const payload = JSON.parse(atob(authTokens.access_token.split('.')[1]));
                if (Date.now() > payload.exp * 1000 - 300000) return await refreshAccessToken();
            } catch (e) { return await refreshAccessToken(); }
            return authTokens.access_token;
        }

