<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Van den Boskes Family Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Outfit', sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            min-height: 100vh;
            color: white;
            overflow-x: hidden;
        }

        /* ===== LOGIN SCREEN ===== */
        .login-screen {
            display: flex; flex-direction: column; align-items: center;
            justify-content: center; height: 100vh; text-align: center; padding: 20px;
        }

        .login-logo { font-size: 4rem; margin-bottom: 10px; }

        .login-title {
            font-size: 2.2rem; font-weight: 300; margin-bottom: 8px; letter-spacing: -0.5px;
        }

        .login-title .family-name {
            font-weight: 500;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }

        .login-subtitle { font-size: 1.1rem; opacity: 0.7; margin-bottom: 35px; }

        .login-btn {
            padding: 16px 45px; border-radius: 12px; border: none;
            background: linear-gradient(135deg, #0078d4, #00a4ef);
            color: white; font-family: 'Outfit', sans-serif; font-size: 1.1rem;
            font-weight: 500; cursor: pointer; transition: all 0.3s ease;
            display: flex; align-items: center; gap: 12px;
        }

        .login-btn:hover { transform: translateY(-3px); box-shadow: 0 15px 40px rgba(0,120,212,0.4); }
        .login-btn svg { width: 22px; height: 22px; }

        .setup-info {
            margin-top: 50px; max-width: 480px; text-align: left;
            background: rgba(255,255,255,0.05); padding: 25px; border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .setup-info h3 { font-weight: 400; margin-bottom: 15px; opacity: 0.9; color: #f5576c; }
        .setup-info ol { opacity: 0.8; line-height: 1.9; padding-left: 20px; }
        .setup-info strong { color: white; }

        .setup-btn {
            margin-top: 20px; padding: 12px 25px; border-radius: 10px; border: none;
            background: rgba(255,255,255,0.1); color: white; font-family: 'Outfit', sans-serif;
            font-size: 1rem; cursor: pointer; transition: all 0.2s;
        }
        .setup-btn:hover { background: rgba(255,255,255,0.2); }

        /* ===== DEVICE CODE SCREEN ===== */
        .device-code-box {
            background: rgba(255,255,255,0.08); border-radius: 20px;
            padding: 35px; margin: 30px 0; text-align: center; max-width: 450px;
        }

        .device-code-step {
            display: flex; align-items: center; gap: 15px;
            margin-bottom: 15px; text-align: left; font-size: 1.1rem;
        }

        .step-number {
            width: 32px; height: 32px; border-radius: 50%;
            background: linear-gradient(135deg, #0078d4, #00a4ef);
            display: flex; align-items: center; justify-content: center;
            font-weight: 600; flex-shrink: 0;
        }

        .verification-url {
            display: block; font-size: 1.4rem; color: #00a4ef;
            text-decoration: none; margin-bottom: 30px;
        }
        .verification-url:hover { text-decoration: underline; }

        .user-code {
            font-size: 3rem; font-weight: 600; letter-spacing: 8px; font-family: monospace;
            background: linear-gradient(135deg, #0078d4, #00a4ef);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            margin-bottom: 30px;
        }

        .device-code-waiting {
            display: flex; align-items: center; justify-content: center;
            gap: 15px; opacity: 0.7; font-size: 1rem;
        }

        /* ===== DASHBOARD LAYOUT ===== */
        .dashboard {
            display: grid;
            grid-template-rows: auto auto auto auto auto auto;
            min-height: 100vh;
            padding: 20px;
            gap: 15px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header > div:first-child {
            flex: 1;
        }

        .header > .dashboard-title {
            flex: 2;
            text-align: center;
        }

        .header > .settings-btn {
            flex: 0 0 auto;
        }

        .dashboard-title {
            font-size: 1.5rem;
            font-weight: 300;
            letter-spacing: -0.5px;
            opacity: 0.9;
        }

        .dashboard-title .family-name {
            font-weight: 500;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .time-section { display: flex; align-items: baseline; gap: 8px; }

        .time {
            font-size: 3.5rem; font-weight: 300; letter-spacing: -3px; line-height: 1;
            background: linear-gradient(180deg, #ffffff 0%, #a0a0a0 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            font-variant-numeric: tabular-nums;
        }

        .time span {
            display: inline-block;
            width: 2.1ch;
            text-align: center;
        }

        .seconds { 
            font-size: 1.4rem; font-weight: 200; opacity: 0.4; 
            display: inline-block;
            width: 2ch;
            text-align: center;
            font-variant-numeric: tabular-nums;
        }
        .date-greeting { margin-left: 15px; }
        
        /* Refresh Button */
        .refresh-btn {
            width: 42px; height: 42px; border-radius: 50%;
            background: rgba(255,255,255,0.1); border: none; color: white;
            font-size: 1.2rem; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.3s ease;
            margin-right: 10px;
        }
        .refresh-btn:hover { background: rgba(255,255,255,0.2); }
        .refresh-btn:active { transform: rotate(180deg); }
        .greeting { font-size: 1.1rem; font-weight: 200; opacity: 0.8; }
        .date { font-size: 0.9rem; font-weight: 300; opacity: 0.7; margin-top: 2px; }

        .settings-btn {
            width: 42px; height: 42px; border-radius: 50%;
            background: rgba(255,255,255,0.1); border: none; color: white;
            font-size: 1.2rem; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.3s ease;
        }
        .settings-btn:hover { background: rgba(255,255,255,0.2); transform: rotate(45deg); }

        /* ===== WEATHER ROW (Full Width) ===== */
        .weather-row {
            display: -webkit-flex;
            display: flex;
            align-items: center;
            gap: 15px;
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(20px);
            border-radius: 12px;
            padding: 10px 15px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        /* ===== CONTENT ROW (Calendar & Todo Side by Side) ===== */
        .content-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            min-height: 0;
            overflow: hidden;
        }

        /* ===== PHOTO ROW (Full Width Bottom) ===== */
        .photo-row {
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(20px);
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.1);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 200px;
        }

        /* ===== CARDS ===== */
        .card {
            background: rgba(255,255,255,0.08); backdrop-filter: blur(20px);
            border-radius: 18px; padding: 18px;
            border: 1px solid rgba(255,255,255,0.1);
            display: flex; flex-direction: column; 
            overflow: hidden;
            min-height: 0;
        }

        .card-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 12px; flex-shrink: 0;
        }

        .card-title { font-size: 1rem; font-weight: 400; display: flex; align-items: center; gap: 8px; }

        .card-content { flex: 1; overflow-y: auto; padding-right: 5px; min-height: 0; }
        .card-content::-webkit-scrollbar { width: 4px; }
        .card-content::-webkit-scrollbar-track { background: rgba(255,255,255,0.05); border-radius: 2px; }
        .card-content::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 2px; }

        .add-btn {
            width: 28px; height: 28px; border-radius: 50%;
            background: rgba(255,255,255,0.15); border: none; color: white;
            font-size: 1.1rem; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.2s;
        }
        .add-btn:hover { background: rgba(255,255,255,0.25); transform: scale(1.1); }

        /* ===== WEATHER SECTION ===== */
        .weather-current {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-right: 20px;
            border-right: 1px solid rgba(255,255,255,0.15);
        }

        .weather-icon-large { font-size: 2rem; }
        .weather-current-info { }
        .weather-temp-large { font-size: 1.8rem; font-weight: 300; }
        .weather-condition { font-size: 0.75rem; opacity: 0.7; }

        .weather-location-wrapper {
            display: flex;
            align-items: center;
            gap: 5px;
            padding-right: 20px;
            border-right: 1px solid rgba(255,255,255,0.15);
        }
        .weather-location { font-size: 0.85rem; opacity: 0.9; display: flex; align-items: center; gap: 5px; }

        .weather-location-btn {
            background: rgba(255,255,255,0.1); border: none; color: white;
            padding: 4px 10px; border-radius: 5px; cursor: pointer;
            font-size: 0.75rem; font-family: 'Outfit', sans-serif; margin-left: 8px;
        }
        .weather-location-btn:hover { background: rgba(255,255,255,0.2); }

        .weather-hi-lo { font-size: 0.75rem; opacity: 0.5; margin-left: 5px; }

        .weather-forecast {
            display: -webkit-flex;
            display: flex;
            gap: 6px;
            flex: 1;
            justify-content: space-around;
        }

        .weather-day {
            text-align: center;
            padding: 5px 8px;
            border-radius: 8px;
            background: rgba(255,255,255,0.05);
            transition: all 0.2s;
        }
        .weather-day:hover { background: rgba(255,255,255,0.1); }

        .weather-day-name { font-size: 0.6rem; opacity: 0.6; margin-bottom: 2px; text-transform: uppercase; }
        .weather-day-icon { font-size: 1rem; margin-bottom: 2px; }
        .weather-day-temp { font-size: 0.7rem; font-weight: 500; }
        .weather-day-low { font-size: 0.6rem; opacity: 0.5; }

        /* ===== PHOTO SECTION ===== */
        .photo-container {
            width: 100%; height: 100%;
            display: flex; align-items: center; justify-content: center;
            position: relative;
        }

        .photo-container img { max-width: 100%; max-height: 100%; object-fit: contain; }

        .photo-placeholder {
            text-align: center; opacity: 0.5; padding: 40px;
        }
        .photo-placeholder-icon { font-size: 4rem; margin-bottom: 15px; }

        .photo-nav {
            position: absolute; bottom: 15px; left: 50%; transform: translateX(-50%);
            display: flex; gap: 6px;
        }

        .photo-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.4); }
        .photo-dot.active { background: white; width: 20px; border-radius: 4px; }

        /* ===== CALENDAR CARD ===== */
        .calendar-card { min-height: 0; height: 100%; }

        .event-item {
            display: flex; align-items: flex-start; gap: 10px;
            padding: 10px; background: rgba(255,255,255,0.05);
            border-radius: 10px; margin-bottom: 8px; transition: all 0.2s;
        }
        .event-item:hover { background: rgba(255,255,255,0.08); }

        .event-time { min-width: 50px; text-align: center; }
        .event-time-start { font-size: 0.9rem; font-weight: 500; }
        .event-time-end { font-size: 0.7rem; opacity: 0.6; }

        .event-divider {
            width: 3px; min-height: 32px;
            background: linear-gradient(180deg, #e94560, #533483); border-radius: 2px;
        }

        .event-details { flex: 1; }
        .event-title { font-size: 0.9rem; font-weight: 400; margin-bottom: 2px; }
        .event-location { font-size: 0.75rem; opacity: 0.6; }

        .event-day-header {
            font-size: 0.75rem; font-weight: 500; opacity: 0.5;
            margin: 12px 0 6px 0; text-transform: uppercase; letter-spacing: 1px;
        }
        .event-day-header:first-child { margin-top: 0; }

        /* ===== TODO CARD ===== */
        .todo-card { min-height: 0; height: 100%; }

        .todo-item {
            display: flex; align-items: center; gap: 10px;
            padding: 10px; background: rgba(255,255,255,0.05);
            border-radius: 10px; margin-bottom: 6px; cursor: pointer; transition: all 0.2s;
        }
        .todo-item:hover { background: rgba(255,255,255,0.1); }
        .todo-item.completing { opacity: 0.5; transform: translateX(20px); }

        .todo-checkbox {
            width: 20px; height: 20px; border-radius: 50%;
            border: 2px solid rgba(255,255,255,0.4); flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; transition: all 0.2s;
        }
        .todo-item:hover .todo-checkbox { border-color: #4ade80; background: rgba(74,222,128,0.1); }
        .todo-checkbox::after { content: '✓'; opacity: 0; color: #4ade80; font-size: 0.7rem; }
        .todo-item:hover .todo-checkbox::after { opacity: 0.5; }

        .todo-text { flex: 1; font-size: 0.85rem; }
        .todo-due { font-size: 0.7rem; opacity: 0.5; }

        /* ===== MODALS ===== */
        .modal-overlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7); backdrop-filter: blur(10px);
            z-index: 1000; align-items: center; justify-content: center;
        }
        .modal-overlay.active { display: flex; }

        .modal {
            background: linear-gradient(135deg, #1e2a4a 0%, #16213e 100%);
            border-radius: 20px; padding: 30px; width: 90%; max-width: 500px;
            border: 1px solid rgba(255,255,255,0.15);
            box-shadow: 0 25px 50px rgba(0,0,0,0.5); max-height: 90vh; overflow-y: auto;
        }
        .modal.wide { max-width: 650px; }

        .modal-header {
            display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;
        }
        .modal-title { font-size: 1.4rem; font-weight: 400; }

        .modal-close {
            width: 36px; height: 36px; border-radius: 50%;
            background: rgba(255,255,255,0.1); border: none; color: white;
            font-size: 1.3rem; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
        }
        .modal-close:hover { background: rgba(255,255,255,0.2); }

        .form-group { margin-bottom: 18px; }
        .form-label { display: block; font-size: 0.85rem; opacity: 0.7; margin-bottom: 6px; }

        .form-input, .form-select {
            width: 100%; padding: 12px 15px; border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.15);
            background: rgba(255,255,255,0.08); color: white;
            font-family: 'Outfit', sans-serif; font-size: 0.95rem;
        }
        .form-input:focus, .form-select:focus {
            outline: none; border-color: rgba(255,255,255,0.4); background: rgba(255,255,255,0.12);
        }
        .form-input::placeholder { color: rgba(255,255,255,0.4); }
        .form-select option { background: #1a1a2e; color: white; }

        .form-row { display: flex; gap: 12px; }
        .form-row .form-group { flex: 1; }

        /* ===== MENTION DROPDOWN ===== */
        .mention-wrapper {
            position: relative;
        }

        .mention-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: rgba(30, 42, 74, 0.98);
            border: 1px solid rgba(255,255,255,0.2);
            border-radius: 10px;
            max-height: 200px;
            overflow-y: auto;
            z-index: 1001;
            display: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
        }

        .mention-dropdown.active {
            display: block;
        }

        .mention-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 15px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .mention-item:hover, .mention-item.selected {
            background: rgba(255,255,255,0.1);
        }

        .mention-item:first-child {
            border-radius: 10px 10px 0 0;
        }

        .mention-item:last-child {
            border-radius: 0 0 10px 10px;
        }

        .mention-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0088cc, #00aaff);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .mention-name {
            font-size: 0.9rem;
        }

        .mention-hint {
            font-size: 0.75rem;
            opacity: 0.5;
            margin-left: auto;
        }

        .task-mention {
            color: #00aaff;
            font-weight: 500;
        }

        .submit-btn {
            width: 100%; padding: 14px; border-radius: 10px; border: none;
            background: linear-gradient(135deg, #e94560, #533483);
            color: white; font-family: 'Outfit', sans-serif; font-size: 1rem;
            font-weight: 500; cursor: pointer; transition: all 0.3s ease; margin-top: 10px;
        }
        .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(233,69,96,0.3); }
        .submit-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
        .submit-btn.secondary { background: rgba(255,255,255,0.15); }
        .submit-btn.secondary:hover { background: rgba(255,255,255,0.25); box-shadow: none; }
        .submit-btn.telegram { background: linear-gradient(135deg, #0088cc, #00aaff); }

        /* ===== SETTINGS TABS ===== */
        .settings-tabs {
            display: flex; gap: 8px; margin-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px;
        }

        .settings-tab {
            padding: 8px 16px; border-radius: 8px; background: transparent; border: none;
            color: white; opacity: 0.6; cursor: pointer; font-family: 'Outfit', sans-serif; font-size: 0.9rem;
        }
        .settings-tab:hover { opacity: 0.8; background: rgba(255,255,255,0.05); }
        .settings-tab.active { opacity: 1; background: rgba(255,255,255,0.1); }

        .settings-section { display: none; }
        .settings-section.active { display: block; }

        /* ===== CONTACTS ===== */
        .contact-list { margin-bottom: 15px; }

        .contact-item {
            display: flex; align-items: center; gap: 12px;
            padding: 12px; background: rgba(255,255,255,0.05);
            border-radius: 10px; margin-bottom: 8px;
        }

        .contact-checkbox {
            width: 22px; height: 22px; border-radius: 6px;
            border: 2px solid rgba(255,255,255,0.3); background: transparent;
            cursor: pointer; display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; transition: all 0.2s;
        }
        .contact-checkbox.checked { background: #4ade80; border-color: #4ade80; }
        .contact-checkbox.checked::after { content: '✓'; color: #1a1a2e; font-size: 0.8rem; font-weight: bold; }

        .contact-avatar {
            width: 36px; height: 36px; border-radius: 50%;
            background: linear-gradient(135deg, #0088cc, #00aaff);
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem; flex-shrink: 0;
        }

        .contact-info { flex: 1; }
        .contact-name { font-size: 0.95rem; font-weight: 400; margin-bottom: 2px; }
        .contact-phone { font-size: 0.8rem; opacity: 0.6; font-family: monospace; }

        .contact-actions { display: flex; gap: 6px; }

        .contact-action-btn {
            width: 28px; height: 28px; border-radius: 6px;
            background: rgba(255,255,255,0.1); border: none; color: white;
            cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;
        }
        .contact-action-btn:hover { background: rgba(255,255,255,0.2); }
        .contact-action-btn.delete:hover { background: rgba(239,68,68,0.3); }

        .add-contact-form {
            background: rgba(255,255,255,0.05); border-radius: 10px; padding: 15px; margin-top: 12px;
        }

        .select-all-bar {
            display: flex; justify-content: space-between; align-items: center;
            padding: 8px 12px; background: rgba(255,255,255,0.03); border-radius: 8px; margin-bottom: 12px;
        }
        .select-all-bar span { opacity: 0.7; font-size: 0.85rem; }

        .select-all-btn {
            padding: 6px 12px; border-radius: 5px; background: rgba(255,255,255,0.1);
            border: none; color: white; cursor: pointer; font-family: 'Outfit', sans-serif;
            font-size: 0.8rem; margin-left: 6px;
        }
        .select-all-btn:hover { background: rgba(255,255,255,0.2); }

        .info-card {
            background: linear-gradient(135deg, rgba(0,136,204,0.2), rgba(0,170,255,0.1));
            border: 1px solid rgba(0,136,204,0.3); border-radius: 10px; padding: 15px; margin-bottom: 15px;
        }
        .info-card h4 { color: #00aaff; margin-bottom: 8px; font-weight: 500; font-size: 0.95rem; }
        .info-card p { opacity: 0.8; font-size: 0.85rem; line-height: 1.6; }
        .info-card code { background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px; font-family: monospace; }

        /* ===== NOTIFICATIONS ===== */
        .notification-option {
            display: flex; align-items: center; justify-content: space-between;
            padding: 12px; background: rgba(255,255,255,0.05); border-radius: 10px; margin-bottom: 8px;
        }

        .notification-option-info { display: flex; align-items: center; gap: 12px; flex: 1; }
        .notification-option-title { font-size: 0.95rem; margin-bottom: 2px; }
        .notification-option-desc { font-size: 0.8rem; opacity: 0.6; }

        .toggle-switch {
            width: 46px; height: 26px; background: rgba(255,255,255,0.2);
            border-radius: 13px; position: relative; cursor: pointer; transition: all 0.3s ease; flex-shrink: 0;
        }
        .toggle-switch.active { background: #4ade80; }
        .toggle-switch::after {
            content: ''; position: absolute; width: 20px; height: 20px;
            background: white; border-radius: 50%; top: 3px; left: 3px; transition: all 0.3s ease;
        }
        .toggle-switch.active::after { left: 23px; }

        /* ===== API STATUS ===== */
        .api-status {
            display: flex; align-items: center; gap: 8px;
            padding: 10px 12px; background: rgba(255,255,255,0.05); border-radius: 8px; margin-bottom: 15px;
        }

        .api-status-dot { width: 10px; height: 10px; border-radius: 50%; background: #f59e0b; }
        .api-status-dot.connected { background: #4ade80; }
        .api-status-dot.error { background: #ef4444; }
        .api-status-text { font-size: 0.85rem; opacity: 0.8; }

        /* ===== WEATHER LOCATIONS ===== */
        .location-item {
            display: flex; align-items: center; gap: 10px;
            padding: 10px; background: rgba(255,255,255,0.05); border-radius: 8px; margin-bottom: 6px;
        }
        .location-item.active { background: rgba(74,222,128,0.15); border: 1px solid rgba(74,222,128,0.3); }
        .location-name { flex: 1; font-size: 0.9rem; }
        .location-btn {
            padding: 4px 10px; border-radius: 5px; background: rgba(255,255,255,0.1);
            border: none; color: white; cursor: pointer; font-size: 0.75rem;
        }
        .location-btn:hover { background: rgba(255,255,255,0.2); }
        .location-btn.delete:hover { background: rgba(239,68,68,0.3); }

        /* ===== PHOTOS CONFIG ===== */
        .photo-source-option {
            padding: 12px; background: rgba(255,255,255,0.05); border-radius: 10px;
            margin-bottom: 8px; cursor: pointer; border: 2px solid transparent;
        }
        .photo-source-option.selected { border-color: #4ade80; background: rgba(74,222,128,0.1); }
        .photo-source-option h4 { font-size: 0.95rem; margin-bottom: 4px; }
        .photo-source-option p { font-size: 0.8rem; opacity: 0.6; }

        /* ===== TOAST ===== */
        .toast {
            position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%) translateY(100px);
            background: rgba(74,222,128,0.9); color: #1a1a2e;
            padding: 12px 25px; border-radius: 10px; font-weight: 500;
            opacity: 0; transition: all 0.3s ease; z-index: 2000;
        }
        .toast.error { background: rgba(239,68,68,0.9); color: white; }
        .toast.active { opacity: 1; transform: translateX(-50%) translateY(0); }

        /* ===== USER INFO ===== */
        .user-info {
            position: fixed; bottom: 20px; left: 20px;
            display: flex; align-items: center; gap: 10px; opacity: 0.6; font-size: 0.85rem;
        }

        .user-avatar {
            width: 28px; height: 28px; border-radius: 50%;
            background: rgba(255,255,255,0.2);
            display: flex; align-items: center; justify-content: center; font-size: 0.8rem;
        }

        .logout-btn {
            background: none; border: none; color: white; opacity: 0.5;
            cursor: pointer; margin-left: 8px; font-size: 0.8rem; text-decoration: underline;
        }
        .logout-btn:hover { opacity: 1; }

        /* ===== LOADING ===== */
        .loading { text-align: center; padding: 30px; opacity: 0.6; }

        .loading-spinner {
            width: 30px; height: 30px;
            border: 3px solid rgba(255,255,255,0.1); border-top-color: white;
            border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 10px;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        .empty-state { text-align: center; padding: 30px; opacity: 0.5; }
        .empty-state-icon { font-size: 2.5rem; margin-bottom: 10px; }

        /* ===== AMBIENT ===== */
        .ambient-orb {
            position: fixed; border-radius: 50%; filter: blur(80px);
            opacity: 0.1; pointer-events: none; z-index: -1;
        }
        .orb-1 { width: 400px; height: 400px; background: #e94560; top: -100px; left: -100px; animation: float 8s ease-in-out infinite; }
        .orb-2 { width: 300px; height: 300px; background: #533483; bottom: -50px; right: -50px; animation: float 10s ease-in-out infinite reverse; }

        @keyframes float {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(30px, 30px); }
        }

        /* ===== TASK CONFIRMATION MODAL ===== */
        .confirm-overlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7); backdrop-filter: blur(8px);
            z-index: 1500; align-items: center; justify-content: center;
        }
        .confirm-overlay.active { display: flex; }

        .confirm-modal {
            background: linear-gradient(135deg, #1e2a4a 0%, #16213e 100%);
            border-radius: 24px; padding: 35px; text-align: center;
            border: 1px solid rgba(255,255,255,0.15);
            box-shadow: 0 25px 60px rgba(0,0,0,0.5); max-width: 380px;
            animation: confirmPop 0.3s ease;
        }

        @keyframes confirmPop {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        .confirm-icon { font-size: 3.5rem; margin-bottom: 15px; }
        .confirm-title { font-size: 1.4rem; font-weight: 500; margin-bottom: 10px; }

        .confirm-task {
            font-size: 1.1rem; opacity: 0.8; margin-bottom: 25px;
            padding: 12px 20px; background: rgba(255,255,255,0.05); border-radius: 10px;
        }

        .confirm-buttons { display: flex; gap: 12px; }

        .confirm-btn {
            flex: 1; padding: 14px 20px; border-radius: 12px; border: none;
            font-family: 'Outfit', sans-serif; font-size: 1rem; font-weight: 500;
            cursor: pointer; transition: all 0.3s ease;
        }

        .confirm-btn.cancel { background: rgba(255,255,255,0.1); color: white; }
        .confirm-btn.cancel:hover { background: rgba(255,255,255,0.2); }

        .confirm-btn.complete { background: linear-gradient(135deg, #4ade80, #22c55e); color: #1a1a2e; }
        .confirm-btn.complete:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(74,222,128,0.4); }

        /* ===== CELEBRATION OVERLAY ===== */
        .celebration-overlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            z-index: 2000; pointer-events: none;
        }
        .celebration-overlay.active { display: block; }

        .celebration-content {
            position: absolute; top: 50%; left: 50%;
            transform: translate(-50%, -50%); text-align: center;
            animation: celebrationPop 0.5s ease;
        }

        @keyframes celebrationPop {
            0% { transform: translate(-50%, -50%) scale(0); }
            50% { transform: translate(-50%, -50%) scale(1.2); }
            100% { transform: translate(-50%, -50%) scale(1); }
        }

        .celebration-emoji { font-size: 5rem; animation: celebrationBounce 0.6s ease infinite alternate; }

        @keyframes celebrationBounce {
            0% { transform: translateY(0); }
            100% { transform: translateY(-20px); }
        }

        .celebration-text {
            font-size: 2.5rem; font-weight: 600; margin-top: 15px;
            background: linear-gradient(135deg, #ffd700, #ff6b6b, #4ade80, #00d4ff);
            background-size: 300% 300%;
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
            animation: gradientShift 2s ease infinite;
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .celebration-subtext { font-size: 1.2rem; opacity: 0.8; margin-top: 10px; color: white; }

        .confetti { position: absolute; width: 10px; height: 10px; opacity: 0; }
        .confetti.active { animation: confettiFall 3s ease-out forwards; }

        @keyframes confettiFall {
            0% { opacity: 1; transform: translateY(0) rotate(0deg); }
            100% { opacity: 0; transform: translateY(100vh) rotate(720deg); }
        }

        .firework { position: absolute; width: 6px; height: 6px; border-radius: 50%; }

        .sparkle { position: absolute; font-size: 1.5rem; opacity: 0; pointer-events: none; }
        .sparkle.active { animation: sparkleAnim 1.5s ease-out forwards; }

        @keyframes sparkleAnim {
            0% { opacity: 1; transform: scale(0) rotate(0deg); }
            50% { opacity: 1; transform: scale(1.5) rotate(180deg); }
            100% { opacity: 0; transform: scale(0) rotate(360deg); }
        }

        .todo-item.completing { opacity: 0.5; transform: translateX(30px); }

        /* Celebration style selector buttons */
        .celebration-style-btn {
            padding: 8px 16px; border-radius: 8px; border: none;
            background: rgba(255,255,255,0.1); color: white;
            font-family: 'Outfit', sans-serif; font-size: 0.85rem;
            cursor: pointer; transition: all 0.2s;
        }
        .celebration-style-btn:hover { background: rgba(255,255,255,0.2); }
        .celebration-style-btn.active { background: linear-gradient(135deg, #4ade80, #22c55e); color: #1a1a2e; }

        /* ===== V12 SCOREBOARD SYSTEM CSS ===== */
        
        /* Dropdown styling */
        select, .form-select {
            padding: 10px 14px;
            border-radius: 10px;
            border: 1px solid rgba(255,255,255,0.3);
            background-color: #1e2a4a !important;
            color: white !important;
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            cursor: pointer;
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='white'%3e%3cpath d='M7 10l5 5 5-5z'/%3e%3c/svg%3e") !important;
            background-repeat: no-repeat !important;
            background-position: right 10px center !important;
            background-size: 20px !important;
            padding-right: 40px;
        }

        select option, .form-select option {
            background-color: #1e2a4a !important;
            color: white !important;
        }

        .year-selector select {
            padding: 8px 12px;
            font-size: 0.95rem;
        }

        /* Chores Row Layout - 2 columns */
        .chores-row {
            display: -webkit-flex;
            display: flex;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            min-height: 0;
            overflow: hidden;
        }

        @media (max-width: 900px) {
            .chores-row { grid-template-columns: 1fr; }
        }

        /* Full width To Do card */
        .todo-card-full {
            max-height: 200px;
        }

        .todo-card-full .card-content {
            max-height: 140px;
        }

        /* Scrollable content areas */
        .scrollable-content {
            max-height: 280px;
            overflow-y: auto;
            padding-right: 5px;
        }

        .scrollable-content::-webkit-scrollbar {
            width: 6px;
        }

        .scrollable-content::-webkit-scrollbar-track {
            background: rgba(255,255,255,0.05);
            border-radius: 3px;
        }

        .scrollable-content::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.2);
            border-radius: 3px;
        }

        .scrollable-content::-webkit-scrollbar-thumb:hover {
            background: rgba(255,255,255,0.3);
        }

        /* Weekly Scoreboard */
        .scoreboard {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .score-item {
            flex: 1;
            min-width: 180px;
            background: rgba(255,255,255,0.05);
            border-radius: 15px;
            padding: 15px;
            text-align: center;
            position: relative;
            cursor: pointer;
            transition: all 0.3s;
        }

        .score-item:hover {
            background: rgba(255,255,255,0.1);
            transform: translateY(-3px);
        }

        .score-item.leader {
            background: linear-gradient(135deg, rgba(255,215,0,0.2), rgba(255,215,0,0.05));
            border: 1px solid rgba(255,215,0,0.3);
        }

        .score-item.leader::before {
            content: '👑';
            position: absolute;
            top: 5px;
            right: 8px;
            font-size: 1.1rem;
        }

        .score-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e94560, #533483);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin: 0 auto 10px;
        }

        .score-name { font-size: 1rem; font-weight: 500; margin-bottom: 3px; }

        .score-points {
            font-size: 2rem;
            font-weight: 600;
            background: linear-gradient(135deg, #4ade80, #22c55e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .score-label { font-size: 0.7rem; opacity: 0.6; margin-bottom: 8px; }

        .score-progress {
            background: rgba(255,255,255,0.1);
            border-radius: 8px;
            height: 8px;
            overflow: hidden;
            margin: 8px 0;
        }

        .score-progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #4ade80, #22c55e);
            border-radius: 8px;
            transition: width 0.5s ease;
        }

        .score-reward-goal {
            font-size: 0.75rem;
            opacity: 0.9;
            padding: 6px;
            background: rgba(255,255,255,0.05);
            border-radius: 8px;
        }

        .score-reward-goal strong { color: #ffd700; }

        .reward-earned-badge {
            background: linear-gradient(135deg, #ffd700, #ffaa00);
            color: #1a1a2e;
            padding: 5px 10px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.75rem;
            display: inline-block;
            animation: pulse 1s ease infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        .edit-goal-btn {
            font-size: 0.65rem;
            background: rgba(255,255,255,0.1);
            border: none;
            color: white;
            padding: 3px 8px;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 6px;
        }

        /* Jackpot Section */
        .jackpot-section {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .jackpot-title {
            font-size: 1.1rem;
            font-weight: 500;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .jackpot-cards {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .jackpot-card {
            flex: 1;
            min-width: 200px;
            background: linear-gradient(135deg, rgba(255,215,0,0.1), rgba(255,165,0,0.05));
            border: 1px solid rgba(255,215,0,0.2);
            border-radius: 15px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }

        .jackpot-card:hover {
            transform: translateY(-3px);
            border-color: rgba(255,215,0,0.4);
        }

        .jackpot-card .name { font-size: 1rem; font-weight: 500; margin-bottom: 5px; }
        .jackpot-card .yearly-total { font-size: 1.8rem; font-weight: 600; color: #ffd700; }
        .jackpot-card .yearly-label { font-size: 0.7rem; opacity: 0.7; margin-bottom: 10px; }

        .jackpot-progress {
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            height: 12px;
            overflow: hidden;
            margin: 8px 0;
        }

        .jackpot-progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #ffd700, #ff8c00);
            border-radius: 10px;
        }

        .jackpot-goal { font-size: 0.8rem; }
        .jackpot-goal strong { color: #ffd700; }

        .jackpot-reward {
            margin-top: 8px;
            padding: 6px 10px;
            background: rgba(255,215,0,0.15);
            border-radius: 8px;
            font-size: 0.75rem;
        }

        .jackpot-earned {
            background: linear-gradient(135deg, #ffd700, #ff8c00);
            color: #1a1a2e;
            padding: 8px 15px;
            border-radius: 10px;
            font-weight: 600;
            margin-top: 10px;
            animation: jackpotPulse 1.5s ease infinite;
        }

        @keyframes jackpotPulse {
            0%, 100% { transform: scale(1); box-shadow: 0 0 20px rgba(255,215,0,0.3); }
            50% { transform: scale(1.02); box-shadow: 0 0 30px rgba(255,215,0,0.5); }
        }

        .edit-jackpot-btn {
            font-size: 0.7rem;
            background: rgba(255,255,255,0.1);
            border: none;
            color: white;
            padding: 4px 10px;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 8px;
        }

        /* Monthly Table */
        .monthly-table-container { overflow-x: auto; }

        .monthly-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

        .monthly-table th, .monthly-table td {
            padding: 10px 8px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .monthly-table th {
            background: rgba(255,255,255,0.05);
            font-weight: 500;
            font-size: 0.75rem;
        }

        .monthly-table th:first-child, .monthly-table td:first-child {
            text-align: left;
            padding-left: 15px;
        }

        .monthly-table .current-month { background: rgba(74,222,128,0.1); font-weight: 600; }
        .monthly-table .total-cell { font-weight: 600; color: #ffd700; background: rgba(255,215,0,0.1); }

        .monthly-table .member-name {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .monthly-table .mini-avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e94560, #533483);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
        }

        /* Chore Items */
        .chore-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            background: rgba(255,255,255,0.05);
            border-radius: 12px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .chore-item:hover {
            background: rgba(255,255,255,0.1);
            transform: translateX(5px);
        }

        .chore-checkbox {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: 2px solid rgba(255,255,255,0.4);
            flex-shrink: 0;
        }

        .chore-item:hover .chore-checkbox {
            border-color: #4ade80;
            background: rgba(74,222,128,0.2);
        }

        .chore-content { flex: 1; }
        .chore-text { font-size: 0.95rem; margin-bottom: 2px; }
        .chore-points { font-size: 0.75rem; color: #4ade80; }

        .chore-completed-by {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

        .completed-tag {
            font-size: 0.7rem;
            padding: 3px 8px;
            background: rgba(74,222,128,0.2);
            color: #4ade80;
            border-radius: 8px;
        }

        /* Delete button for chores */
        .delete-chore-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(239, 68, 68, 0.2);
            border: 1px solid rgba(239, 68, 68, 0.4);
            color: #ef4444;
            font-size: 1rem;
            cursor: pointer;
            display: none;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: all 0.2s;
        }

        .delete-chore-btn:hover {
            background: rgba(239, 68, 68, 0.4);
            transform: scale(1.1);
        }

        body.edit-mode .delete-chore-btn {
            display: flex;
        }

        body.edit-mode .chores-card {
            border: 2px solid rgba(239, 68, 68, 0.5);
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.2);
        }

        /* Edit Mode Button */
        .edit-mode-btn {
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: white;
            padding: 6px 12px;
            border-radius: 8px;
            cursor: pointer;
            font-family: 'Outfit', sans-serif;
            font-size: 0.75rem;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: all 0.2s;
        }

        .edit-mode-btn:hover {
            background: rgba(255,255,255,0.2);
        }

        .edit-mode-btn.active {
            background: rgba(239, 68, 68, 0.2);
            border-color: rgba(239, 68, 68, 0.5);
            color: #ef4444;
            animation: editPulse 2s ease infinite;
        }

        @keyframes editPulse {
            0%, 100% { box-shadow: 0 0 5px rgba(239, 68, 68, 0.3); }
            50% { box-shadow: 0 0 15px rgba(239, 68, 68, 0.5); }
        }

        .reset-btn {
            background: rgba(239,68,68,0.15);
            border: 1px solid rgba(239,68,68,0.3);
            color: #ef4444;
            padding: 8px 15px;
            border-radius: 8px;
            cursor: pointer;
            font-family: 'Outfit', sans-serif;
            font-size: 0.8rem;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .header-buttons {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        /* PIN Modal */
        .pin-modal .modal { max-width: 320px; text-align: center; }
        .pin-icon { font-size: 3rem; margin-bottom: 10px; text-align: center; }
        .pin-description { font-size: 0.9rem; opacity: 0.8; margin-bottom: 20px; text-align: center; }

        .pin-input-container {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
        }

        .pin-digit {
            width: 50px;
            height: 60px;
            border-radius: 12px;
            border: 2px solid rgba(255,255,255,0.2);
            background: rgba(255,255,255,0.05);
            color: white;
            font-size: 1.5rem;
            font-weight: 600;
            text-align: center;
            font-family: 'Outfit', sans-serif;
        }

        .pin-digit:focus {
            outline: none;
            border-color: #4ade80;
            background: rgba(74,222,128,0.1);
        }

        .pin-error {
            color: #ef4444;
            font-size: 0.85rem;
            margin-bottom: 15px;
            display: none;
            text-align: center;
        }

        .pin-error.active { display: block; }

        /* Who Modal */
        .who-completed-modal .modal { max-width: 350px; text-align: center; }

        .who-completed-task {
            font-size: 1.1rem;
            font-weight: 500;
            padding: 12px;
            background: rgba(255,255,255,0.05);
            border-radius: 10px;
            margin-bottom: 20px;
            text-align: center;
        }

        .who-buttons { display: flex; flex-direction: column; gap: 10px; }

        .who-btn {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 14px 18px;
            border-radius: 12px;
            border: 2px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.05);
            color: white;
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .who-btn:hover {
            background: rgba(255,255,255,0.15);
            border-color: #4ade80;
            transform: translateX(5px);
        }

        .who-btn .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e94560, #533483);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .who-btn .points-preview { margin-left: auto; color: #4ade80; font-weight: 500; }

        /* Confirm Modal */
        .confirm-modal-v12 .modal { max-width: 360px; text-align: center; }
        .confirm-icon-v12 { font-size: 2.5rem; margin-bottom: 15px; text-align: center; }
        .confirm-message-v12 { font-size: 1rem; margin-bottom: 20px; line-height: 1.5; text-align: center; }
        .confirm-buttons-v12 { display: flex; gap: 12px; }

        .confirm-btn-v12 {
            flex: 1;
            padding: 12px 18px;
            border-radius: 10px;
            border: none;
            font-family: 'Outfit', sans-serif;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
        }

        .confirm-btn-v12.cancel { background: rgba(255,255,255,0.1); color: white; }
        .confirm-btn-v12.danger { background: linear-gradient(135deg, #ef4444, #dc2626); color: white; }

        /* Chore Celebration */
        .chore-celebration-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 2000;
            pointer-events: none;
        }

        .chore-celebration-overlay.active { display: block; }

        .chore-celebration-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            animation: choreCelebrationPop 0.5s ease;
        }

        @keyframes choreCelebrationPop {
            0% { transform: translate(-50%, -50%) scale(0); }
            50% { transform: translate(-50%, -50%) scale(1.2); }
            100% { transform: translate(-50%, -50%) scale(1); }
        }

        .chore-celebration-emoji { font-size: 4rem; animation: choreBounce 0.6s ease infinite alternate; }

        @keyframes choreBounce {
            0% { transform: translateY(0); }
            100% { transform: translateY(-15px); }
        }

        .chore-celebration-text {
            font-size: 2rem;
            font-weight: 600;
            margin-top: 10px;
            background: linear-gradient(135deg, #ffd700, #ff6b6b, #4ade80, #00d4ff);
            background-size: 300% 300%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: gradientShift 2s ease infinite;
        }

        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .chore-celebration-points { font-size: 1.2rem; margin-top: 8px; color: #4ade80; }
        .chore-celebration-reward { font-size: 1rem; margin-top: 5px; color: #ffd700; }

        .chore-confetti { position: absolute; width: 10px; height: 10px; opacity: 0; }
        .chore-confetti.active { animation: choreConfettiFall 3s ease-out forwards; }

        @keyframes choreConfettiFall {
            0% { opacity: 1; transform: translateY(0) rotate(0deg); }
            100% { opacity: 0; transform: translateY(100vh) rotate(720deg); }
        }

        /* Jackpot Celebration */
        .jackpot-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9);
            z-index: 3000;
            align-items: center;
            justify-content: center;
        }

        .jackpot-overlay.active { display: flex; }

        .jackpot-celebration { text-align: center; animation: jackpotAppear 0.8s ease; }

        @keyframes jackpotAppear {
            0% { transform: scale(0) rotate(-20deg); opacity: 0; }
            50% { transform: scale(1.2) rotate(10deg); }
            100% { transform: scale(1) rotate(0deg); opacity: 1; }
        }

        .jackpot-celebration .mega-emoji {
            font-size: 8rem;
            animation: jackpotBounce 0.5s ease infinite alternate;
        }

        @keyframes jackpotBounce {
            0% { transform: translateY(0) scale(1); }
            100% { transform: translateY(-30px) scale(1.1); }
        }

        .jackpot-celebration .mega-title {
            font-size: 3rem;
            font-weight: 700;
            margin: 20px 0;
            background: linear-gradient(135deg, #ffd700, #ff8c00, #ffd700);
            background-size: 200% 200%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: goldShimmer 1s ease infinite;
        }

        @keyframes goldShimmer {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .jackpot-celebration .winner-name { font-size: 2rem; color: white; }
        .jackpot-celebration .prize-text {
            font-size: 1.5rem;
            color: #ffd700;
            padding: 15px 30px;
            background: rgba(255,215,0,0.15);
            border-radius: 15px;
            display: inline-block;
            margin: 20px 0;
        }

        .jackpot-celebration .close-jackpot {
            margin-top: 30px;
            padding: 15px 40px;
            border-radius: 30px;
            border: none;
            background: linear-gradient(135deg, #ffd700, #ff8c00);
            color: #1a1a2e;
            font-family: 'Outfit', sans-serif;
            font-size: 1.2rem;
            font-weight: 700;
            cursor: pointer;
            pointer-events: auto;
        }

        .sound-toggle {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: rgba(255,255,255,0.1);
            border: none;
            color: white;
            padding: 10px 18px;
            border-radius: 25px;
            cursor: pointer;
            font-family: 'Outfit', sans-serif;
            display: flex;
            align-items: center;
            gap: 8px;
            z-index: 50;
        }

        .section-divider {
            border-top: 1px solid rgba(255,255,255,0.1);
            margin: 12px 0;
            padding-top: 12px;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }

        .edit-mode-banner {
            display: none;
            position: fixed;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #ef4444, #dc2626);
            padding: 8px 20px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            z-index: 99;
            animation: bannerPulse 2s ease infinite;
        }

        body.edit-mode .edit-mode-banner {
            display: block;
        }

        @keyframes bannerPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }

        /* ===== POPUP KEYBOARD ===== */
        .keyboard-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.7);
            z-index: 5000;
            align-items: flex-end;
            justify-content: center;
        }
        .keyboard-overlay.active { display: flex; }

        .keyboard-container {
            width: 100%;
            max-width: 900px;
            background: linear-gradient(135deg, #1e2a4a 0%, #16213e 100%);
            border-radius: 20px 20px 0 0;
            padding: 15px;
            border: 1px solid rgba(255,255,255,0.2);
        }

        .keyboard-input-row {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
            align-items: center;
        }

        .keyboard-input {
            flex: 1;
            padding: 15px 20px;
            border-radius: 12px;
            border: 2px solid rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.1);
            color: white;
            font-family: 'Outfit', sans-serif;
            font-size: 1.2rem;
        }

        .keyboard-done-btn {
            padding: 15px 30px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #4ade80, #22c55e);
            color: #1a1a2e;
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
        }

        .keyboard-cancel-btn {
            padding: 15px 20px;
            border-radius: 12px;
            border: none;
            background: rgba(239,68,68,0.3);
            color: #ef4444;
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            cursor: pointer;
        }

        .keyboard-rows { display: flex; flex-direction: column; gap: 8px; }

        .keyboard-row {
            display: flex;
            justify-content: center;
            gap: 6px;
        }

        .key {
            min-width: 45px;
            height: 50px;
            border-radius: 8px;
            border: none;
            background: rgba(255,255,255,0.15);
            color: white;
            font-family: 'Outfit', sans-serif;
            font-size: 1.1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.1s;
        }

        .key:active {
            background: rgba(74,222,128,0.4);
            transform: scale(0.95);
        }

        .key.wide { min-width: 70px; font-size: 0.9rem; }
        .key.extra-wide { min-width: 100px; }
        .key.space { flex: 1; max-width: 300px; }
        .key.backspace { background: rgba(239,68,68,0.3); }
        .key.shift { background: rgba(99,102,241,0.3); }
        .key.shift.active { background: rgba(99,102,241,0.6); }

        /* ===== PIN KEYPAD ===== */
        .pin-keypad-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.85);
            z-index: 6000;
            align-items: center;
            justify-content: center;
        }
        .pin-keypad-overlay.active { display: flex; }

        .pin-keypad {
            background: linear-gradient(135deg, #1e2a4a 0%, #16213e 100%);
            border-radius: 24px;
            padding: 30px;
            border: 1px solid rgba(255,255,255,0.2);
            text-align: center;
        }

        .pin-keypad-title {
            font-size: 1.3rem;
            margin-bottom: 10px;
        }

        .pin-keypad-display {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin: 20px 0;
        }

        .pin-keypad-dot {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 2px solid rgba(255,255,255,0.4);
            background: transparent;
        }

        .pin-keypad-dot.filled {
            background: #4ade80;
            border-color: #4ade80;
        }

        .pin-keypad-grid {
            display: grid;
            grid-template-columns: repeat(3, 70px);
            gap: 10px;
            justify-content: center;
        }

        .pin-key {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            border: none;
            background: rgba(255,255,255,0.15);
            color: white;
            font-family: 'Outfit', sans-serif;
            font-size: 1.8rem;
            font-weight: 500;
            cursor: pointer;
        }

        .pin-key:active {
            background: rgba(74,222,128,0.4);
        }

        .pin-key.cancel {
            background: rgba(239,68,68,0.3);
            font-size: 1.2rem;
        }

        .pin-key.backspace {
            background: rgba(255,255,255,0.1);
            font-size: 1.5rem;
        }

        .pin-keypad-error {
            color: #ef4444;
            font-size: 0.9rem;
            margin-top: 15px;
            min-height: 25px;
        }

        /* ===== DAKBOARD COMPATIBILITY ===== */
        /* Simple year buttons instead of select dropdown */
        .year-buttons {
            display: -webkit-flex;
            display: flex;
            gap: 5px;
            -webkit-flex-wrap: wrap;
            flex-wrap: wrap;
        }

        .year-btn {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.2);
            background-color: rgba(255,255,255,0.1);
            color: white;
            font-family: 'Outfit', sans-serif;
            font-size: 0.85rem;
            cursor: pointer;
        }

        .year-btn.active {
            background-color: #ffd700;
            color: #1a1a2e;
            border-color: #ffd700;
            font-weight: 600;
        }

        /* DAKBOARD: Force all sections visible with fallback properties */
        .jackpot-section {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            height: auto !important;
            overflow: visible !important;
            position: relative !important;
        }

        .jackpot-cards {
            display: -webkit-flex !important;
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
            -webkit-flex-wrap: wrap;
            flex-wrap: wrap;
        }

        .jackpot-card {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            -webkit-flex: 1;
            flex: 1;
            min-width: 200px;
        }

        .monthly-table-container {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            overflow-x: auto !important;
        }

        .monthly-table {
            display: table !important;
            visibility: visible !important;
            opacity: 1 !important;
            width: 100% !important;
        }

        .monthly-table thead,
        .monthly-table tbody,
        .monthly-table tr,
        .monthly-table th,
        .monthly-table td {
            visibility: visible !important;
            opacity: 1 !important;
        }

        /* DAKBOARD: Scoreboard visibility */
        .scoreboard {
            display: -webkit-flex !important;
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
            -webkit-flex-wrap: wrap;
            flex-wrap: wrap;
        }

        .score-item {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }

        /* DAKBOARD: Remove backdrop-filter (not supported in older Chrome) */
        @supports not (backdrop-filter: blur(20px)) {
            .card, .weather-row, .modal {
                background-color: rgba(30, 42, 74, 0.95);
            }
        }
    </style>
</head>
<body>
    <div class="ambient-orb orb-1"></div>
    <div class="ambient-orb orb-2"></div>

    <!-- ===== LOGIN SCREEN ===== -->
    <div class="login-screen" id="loginScreen">
        <div class="login-logo">🏠</div>
        <div class="login-title">The <span class="family-name">Van den Boskes</span> Family Dashboard</div>
        <div class="login-subtitle">Connect your Microsoft 365 account to get started</div>
        
        <button class="login-btn" onclick="signIn()">
            <svg viewBox="0 0 23 23" fill="currentColor">
                <path d="M0 0h11v11H0zM12 0h11v11H12zM0 12h11v11H0zM12 12h11v11H12z"/>
            </svg>
            Sign in with Microsoft
        </button>

        <div class="setup-info" style="border-color: rgba(74,222,128,0.3); background: rgba(74,222,128,0.05);">
            <h3 style="color: #4ade80;">✅ Ready to Sign In</h3>
            <ol>
                <li><strong>Click "Sign in with Microsoft"</strong> above</li>
                <li>On your phone, go to <strong>microsoft.com/devicelogin</strong></li>
                <li>Enter the code shown on screen</li>
                <li>Sign in and enjoy your dashboard!</li>
            </ol>
            <button class="setup-btn" onclick="openModal('settings'); setTimeout(() => switchSettingsTab('api'), 100);">⚙️ View API Settings</button>
        </div>
    </div>

    <!-- ===== DEVICE CODE SCREEN ===== -->
    <div class="login-screen" id="deviceCodeScreen" style="display: none;">
        <div class="login-logo">🔐</div>
        <div class="login-title">Sign In</div>
        <div class="login-subtitle">Use another device to complete sign-in</div>
        
        <div class="device-code-box">
            <div class="device-code-step">
                <div class="step-number">1</div>
                <div>On your phone or computer, go to:</div>
            </div>
            <a href="https://microsoft.com/devicelogin" target="_blank" id="verificationUrl" class="verification-url">microsoft.com/devicelogin</a>
            
            <div class="device-code-step">
                <div class="step-number">2</div>
                <div>Enter this code:</div>
            </div>
            <div class="user-code" id="userCode">XXXXXXXX</div>
            
            <div class="device-code-waiting">
                <div class="loading-spinner"></div>
                <span>Waiting for you to sign in...</span>
            </div>
        </div>

        <button class="submit-btn secondary" style="max-width: 250px;" onclick="cancelLogin()">Cancel</button>
    </div>

    <!-- ===== MAIN DASHBOARD ===== -->
    <div class="dashboard" id="dashboard" style="display: none;">
        <!-- Row 1: Header -->
        <div class="header">
            <div style="display: flex; align-items: center;">
                <div class="time-section">
                    <div class="time"><span id="hours">00</span>:<span id="minutes">00</span></div>
                    <div class="seconds" id="seconds">00</div>
                </div>
                <div class="date-greeting">
                    <div class="greeting" id="greeting">Good evening</div>
                    <div class="date" id="date">Loading...</div>
                </div>
            </div>
            <div class="dashboard-title">🏠 The <span class="family-name">Van den Boskes</span> Family Dashboard</div>
            <div style="display: flex; align-items: center;">
                <button class="refresh-btn" onclick="location.reload()" title="Refresh">🔄</button>
                <button class="settings-btn" onclick="openModal('settings')" title="Settings">⚙️</button>
            </div>
        </div>

        <!-- Row 2: Weather (Full Width) -->
        <div class="weather-row">
            <div class="weather-current">
                <div class="weather-icon-large" id="weatherIcon">🌡️</div>
                <div class="weather-current-info">
                    <div class="weather-temp-large" id="weatherTemp">--°</div>
                    <div class="weather-condition" id="weatherCondition">Loading...</div>
                </div>
            </div>
            <div class="weather-location-wrapper">
                <div class="weather-location">
                    <span>📍</span>
                    <span id="weatherLocationName">Loading...</span>
                    <button class="weather-location-btn" onclick="openModal('settings'); setTimeout(() => switchSettingsTab('weather'), 100);">Change</button>
                </div>
                <div class="weather-hi-lo" id="weatherHiLo">H:--° L:--°</div>
            </div>
            <div class="weather-forecast" id="weatherForecast">
                <div class="weather-day"><div class="loading-spinner" style="width:20px;height:20px;border-width:2px;"></div></div>
            </div>
        </div>

        <!-- Row 3: Scoreboard (Full Width) -->
        <div class="card" style="grid-column: 1 / -1; display: block; visibility: visible; opacity: 1;">
            <div class="card-header">
                <div class="card-title">🏆 Weekly Scoreboard</div>
                <button type="button" class="reset-btn" onclick="requestPinForAction('resetWeek')">
                    <span class="lock-icon">🔒</span> Reset Week
                </button>
            </div>
            <div class="scoreboard" id="scoreboard" style="display: flex; visibility: visible; opacity: 1;"></div>

            <div class="jackpot-section" style="display: block; visibility: visible; opacity: 1;">
                <div class="jackpot-title">
                    🎰 Super Ultimate Jackpot 
                    <div class="year-buttons" id="yearButtons" style="display: flex; visibility: visible;">
                        <button type="button" class="year-btn active" onclick="changeYearTo(2025)">2025</button>
                        <button type="button" class="year-btn" onclick="changeYearTo(2026)">2026</button>
                        <button type="button" class="year-btn" onclick="changeYearTo(2027)">2027</button>
                        <button type="button" class="year-btn" onclick="changeYearTo(2028)">2028</button>
                        <button type="button" class="year-btn" onclick="changeYearTo(2029)">2029</button>
                        <button type="button" class="year-btn" onclick="changeYearTo(2030)">2030</button>
                        <button type="button" class="year-btn" onclick="changeYearTo(2031)">2031</button>
                        <button type="button" class="year-btn" onclick="changeYearTo(2032)">2032</button>
                        <button type="button" class="year-btn" onclick="changeYearTo(2033)">2033</button>
                        <button type="button" class="year-btn" onclick="changeYearTo(2034)">2034</button>
                        <button type="button" class="year-btn" onclick="changeYearTo(2035)">2035</button>
                    </div>
                </div>
                <div class="jackpot-cards" id="jackpotCards" style="display: flex; visibility: visible; opacity: 1;"></div>
            </div>
        </div>

        <!-- Row 4: Monthly Table (Full Width) -->
        <div class="card" style="grid-column: 1 / -1; display: block; visibility: visible; opacity: 1;">
            <div class="card-header">
                <div class="card-title">📅 Monthly Points <span id="monthlyYearLabel">2025</span></div>
                <button type="button" class="reset-btn" onclick="requestPinForAction('resetYear')">
                    <span class="lock-icon">🔒</span> Reset Year
                </button>
            </div>
            <div class="monthly-table-container" style="display: block; visibility: visible; opacity: 1; overflow-x: auto;">
                <table class="monthly-table" id="monthlyTable" style="display: table; visibility: visible; opacity: 1; width: 100%;"></table>
            </div>
        </div>

        <!-- Row 5: Chores & Calendar (2 columns) -->
        <div class="chores-row">
            <!-- Chores Card -->
            <div class="card chores-card">
                <div class="card-header">
                    <div class="card-title">🧹 Daily Chores</div>
                    <div class="header-buttons">
                        <button type="button" class="edit-mode-btn" id="editModeBtn" onclick="toggleEditMode()">
                            <span id="editModeIcon">🔒</span>
                            <span id="editModeText">Edit</span>
                        </button>
                        <button type="button" class="add-btn" onclick="openAddChoreModal()">+</button>
                    </div>
                </div>
                <div id="choresList" class="scrollable-content"></div>
                <div class="section-divider">
                    <button type="button" class="reset-btn" onclick="requestPinForAction('resetDay')" style="width:100%;">
                        <span class="lock-icon">🔒</span> New Day - Reset Chores
                    </button>
                </div>
            </div>

            <!-- Calendar -->
            <div class="card calendar-card">
                <div class="card-header">
                    <div class="card-title">📅 Calendar</div>
                    <button class="add-btn" onclick="openModal('event')">+</button>
                </div>
                <div class="card-content scrollable-content" id="calendarContent">
                    <div class="loading"><div class="loading-spinner"></div>Loading events...</div>
                </div>
            </div>
        </div>

        <!-- Row 6: Microsoft To Do (Full Width) -->
        <div class="card todo-card-full" style="grid-column: 1 / -1;">
            <div class="card-header">
                <div class="card-title">✅ Microsoft To Do</div>
                <button class="add-btn" onclick="openModal('todo')">+</button>
            </div>
            <div class="card-content scrollable-content" id="todoContent">
                <div class="loading"><div class="loading-spinner"></div>Loading tasks...</div>
            </div>
        </div>
    </div>

    <!-- Edit Mode Banner -->
    <div class="edit-mode-banner">✏️ EDIT MODE - Tap 🗑️ to delete chores</div>

    <!-- User Info -->
    <div class="user-info" id="userInfo" style="display: none;">
        <div class="user-avatar">👤</div>
