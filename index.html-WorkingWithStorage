        async function refreshAccessToken() {
            if (!authTokens || !authTokens.refresh_token || !apiConfig.functionUrl) throw new Error('Cannot refresh');

            const resp = await fetch(`${apiConfig.functionUrl}/api/auth/refresh?code=${apiConfig.functionKey}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ client_id: clientId, refresh_token: authTokens.refresh_token, scope: graphScopes })
            });

            const data = await resp.json();
            if (data.access_token) {
                authTokens = data;
                saveData(STORAGE_KEYS.AUTH_TOKENS, data);
                return data.access_token;
            }
            throw new Error(data.error_description || 'Refresh failed');
        }

        async function fetchUserInfo() {
            try {
