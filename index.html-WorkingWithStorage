            if (!apiConfig.functionUrl) { showToast('Configure API first', true); return; }
            const enabled = contacts.filter(c => c.enabled);
            if (!enabled.length) { showToast('No contacts selected', true); return; }

            try {
                const resp = await fetch(`${apiConfig.functionUrl}/api/testNotification?code=${apiConfig.functionKey}`, {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ contacts: enabled.map(c => c.chatId) })
                });
                if (resp.ok) showToast('Test notification sent!');
